<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AlbumActivity">

    <ScrollView
        android:id="@+id/photoScroll"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">

        <LinearLayout
            android:id="@+id/photoScrollContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/displayPhotoButon"
        android:text="Display Photo"
        android:layout_width="150dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/photoScroll"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp">
    </Button>

    <Button
        android:id="@+id/addPhotoButon"
        android:text="Add Photo"
        android:layout_width="150dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/displayPhotoButon"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="10dp">
    </Button>

    <Button
        android:id="@+id/movePhotoButon"
        android:text="Move To Album"
        android:layout_width="150dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/displayPhotoButon"
        app:layout_constraintStart_toStartOf="@id/displayPhotoButon"
        android:layout_marginTop="10dp">
    </Button>

    <Button
        android:id="@+id/removePhotoButon"
        android:text="Remove Photo"
        android:layout_width="150dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/movePhotoButon"
        app:layout_constraintEnd_toEndOf="@id/addPhotoButon">
    </Button>
</androidx.constraintlayout.widget.ConstraintLayout>