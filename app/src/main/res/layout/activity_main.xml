<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <HorizontalScrollView
        android:id="@+id/albumScroll"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">

        <LinearLayout
            android:id="@+id/albumScrollContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

<!--                <ImageView-->
<!--                    android:id="@+id/imageView2"-->
<!--                    android:layout_width="300dp"-->
<!--                    android:layout_height="300dp"-->
<!--                    tools:srcCompat="@tools:sample/backgrounds/scenic">-->
<!--                </ImageView>-->

<!--                <Button-->
<!--                    android:id="@+id/Test"-->
<!--                    android:text="Test"-->
<!--                    android:layout_width="150dp"-->
<!--                    android:layout_height="50dp">-->
<!--                </Button>-->

        </LinearLayout>

    </HorizontalScrollView>

    <Button
        android:id="@+id/openAlbumButon"
        android:text="Open Album"
        android:layout_width="150dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/albumScroll"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp">
    </Button>

    <Button
        android:id="@+id/createAlbumButon"
        android:text="Create Album"
        android:layout_width="150dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/openAlbumButon"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="10dp">
    </Button>

    <Button
        android:id="@+id/renameAlbumButon"
        android:text="Rename Album"
        android:layout_width="150dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/openAlbumButon"
        app:layout_constraintStart_toStartOf="@id/openAlbumButon"
        android:layout_marginTop="10dp">
    </Button>

    <Button
        android:id="@+id/deleteAlbumButon"
        android:text="Delete Album"
        android:layout_width="150dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/renameAlbumButon"
        app:layout_constraintEnd_toEndOf="@id/createAlbumButon">
    </Button>

    <TextView
        android:id="@+id/tagSearch"
        android:text="Tag Search"
        android:layout_width="150dp"
        android:layout_height="30dp"
        android:gravity="center"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/renameAlbumButon"
        android:layout_marginTop="10dp">
    </TextView>

    <Spinner
        android:id="@+id/tagDropdown1"
        android:layout_width="125dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/tagSearch"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp">
    </Spinner>

    <Spinner
        android:id="@+id/conjunctionBox"
        android:layout_width="100dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/tagDropdown1"
        app:layout_constraintStart_toEndOf="@+id/tagDropdown1"
        app:layout_constraintEnd_toStartOf="@id/tagDropdown2">
    </Spinner>

    <Spinner
        android:id="@+id/tagDropdown2"
        android:layout_width="125dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/tagDropdown1"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="10dp">
    </Spinner>

    <Spinner
        android:id="@+id/valueDropdown1"
        android:layout_width="125dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/tagDropdown1"
        app:layout_constraintStart_toStartOf="@id/tagDropdown1"
        android:layout_marginTop="10dp">
    </Spinner>

    <Button
        android:id="@+id/tagSearchButon"
        android:text="Search"
        android:layout_width="100dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/valueDropdown1"
        app:layout_constraintStart_toEndOf="@+id/valueDropdown1"
        app:layout_constraintEnd_toStartOf="@id/valueDropdown2">
    </Button>

    <Spinner
        android:id="@+id/valueDropdown2"
        android:layout_width="125dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/valueDropdown1"
        app:layout_constraintEnd_toEndOf="@id/tagDropdown2">
    </Spinner>

    <TextView
        android:id="@+id/dateSearch"
        android:text="Date Search"
        android:layout_width="150dp"
        android:layout_height="30dp"
        android:gravity="center"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tagSearchButon"
        android:layout_marginTop="10dp">
    </TextView>

    <EditText
        android:id="@+id/fromDate"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:ems="10"
        android:inputType="date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dateSearch">
    </EditText>

    <EditText
        android:id="@+id/toDate"
        android:layout_width="200dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/fromDate"
        app:layout_constraintStart_toStartOf="@id/fromDate"
        android:layout_marginTop="10dp"
        android:ems="10"
        android:inputType="date">
    </EditText>

    <Button
        android:id="@+id/dateSearchButon"
        android:text="Search"
        android:layout_width="100dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/fromDate"
        app:layout_constraintBottom_toBottomOf="@id/toDate"
        app:layout_constraintStart_toEndOf="@+id/fromDate"
        app:layout_constraintEnd_toEndOf="parent">
    </Button>

</androidx.constraintlayout.widget.ConstraintLayout>