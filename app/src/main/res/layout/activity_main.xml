<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <HorizontalScrollView
        android:id="@+id/albumScroll"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp">

        <LinearLayout
            android:id="@+id/albumScrollContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
        </LinearLayout>

    </HorizontalScrollView>

    <Button
        android:id="@+id/openAlbumButon"
        android:text="Open Album"
        android:layout_width="150dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/albumScroll"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp">
    </Button>

    <Button
        android:id="@+id/createAlbumButon"
        android:text="Create Album"
        android:layout_width="150dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/openAlbumButon"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="10dp">
    </Button>

    <Button
        android:id="@+id/renameAlbumButon"
        android:text="Rename Album"
        android:layout_width="150dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/openAlbumButon"
        app:layout_constraintStart_toStartOf="@id/openAlbumButon"
        android:layout_marginTop="10dp">
    </Button>

    <Button
        android:id="@+id/deleteAlbumButon"
        android:text="Delete Album"
        android:layout_width="150dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/renameAlbumButon"
        app:layout_constraintEnd_toEndOf="@id/createAlbumButon">
    </Button>

    <TextView
        android:id="@+id/tagSearch"
        android:text="Tag Search"
        android:layout_width="150dp"
        android:layout_height="30dp"
        android:gravity="center"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/renameAlbumButon"
        android:layout_marginTop="10dp">
    </TextView>

    <Spinner
        android:id="@+id/tagDropdown1"
        android:layout_width="125dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/tagSearch"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp">
    </Spinner>

    <Spinner
        android:id="@+id/conjunctionBox"
        android:layout_width="100dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/tagDropdown1"
        app:layout_constraintStart_toEndOf="@+id/tagDropdown1"
        app:layout_constraintEnd_toStartOf="@id/tagDropdown2">
    </Spinner>

    <Spinner
        android:id="@+id/tagDropdown2"
        android:layout_width="125dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/tagDropdown1"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="10dp">
    </Spinner>

    <EditText
        android:id="@+id/valueField1"
        android:layout_width="125dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/tagDropdown1"
        app:layout_constraintStart_toStartOf="@id/tagDropdown1"
        android:layout_marginTop="10dp"
        android:inputType="text"
        android:hint="--Value 1--">
    </EditText>

    <Button
        android:id="@+id/tagSearchButon"
        android:text="Search"
        android:layout_width="100dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/valueField1"
        app:layout_constraintStart_toEndOf="@+id/valueField1"
        app:layout_constraintEnd_toStartOf="@id/valueField2">
    </Button>

    <EditText
        android:id="@+id/valueField2"
        android:layout_width="125dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="@id/valueField1"
        app:layout_constraintEnd_toEndOf="@id/tagDropdown2"
        android:inputType="text"
        android:hint="--Value 2--">
    </EditText>

